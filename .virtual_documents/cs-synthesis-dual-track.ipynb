# Dual-track data generation + baseline metrics (A, B, shuffled A+B)
from collections import Counter
import json
import re
from pathlib import Path

# Ensure output directories exist for this block.
DUAL_TEXT_OUT = TEXT_OUT / "dual_track"
DUAL_MANIFEST_OUT = MANIFEST_OUT / "dual_track"
DUAL_TEXT_OUT.mkdir(parents=True, exist_ok=True)
DUAL_MANIFEST_OUT.mkdir(parents=True, exist_ok=True)

# Local helpers to avoid dependency on earlier cells if run standalone.
def _safe_text(x):
    return "" if x is None else str(x)

def _norm(x: str) -> str:
    x = _safe_text(x)
    x = re.sub(r"\s*([,.;:!?])\s*", r"\1 ", x)
    x = re.sub(r"\s+", " ", x)
    return x.strip()

def _tok(x: str):
    return re.findall(r"\w+|[^\w\s]", x, flags=re.UNICODE)

def _is_word(t: str) -> bool:
    return re.fullmatch(r"\w+", t) is not None

def _read_parallel(path_a: Path, path_b: Path, key_a: str, key_b: str):
    rows = []
    with path_a.open("r", encoding="utf-8") as fa, path_b.open("r", encoding="utf-8") as fb:
        for la, lb in zip(fa, fb):
            la = la.strip()
            lb = lb.strip()
            if la and lb:
                rows.append({key_a: la, key_b: lb})
    return rows

# Required parallel sources for dual-track plan
swc_fra_dir = ROOT / "synthesis_inputs" / "gamayun_kit5k_fra-swc" / "kit5k"
fra_lin_dir = ROOT / "synthesis_inputs" / "gamayun_kit5k-v1_FRA-LIN" / "fr-kit5k-v1"

swc_file = swc_fra_dir / "SWC-FRA_kit5k_sentences.SWC.txt"
fra_file_a = swc_fra_dir / "SWC-FRA_kit5k_sentences.FRA.txt"
fra_file_b = fra_lin_dir / "gamayun_kit5k-v1_fra-lin_FRA.txt"
lin_file = fra_lin_dir / "gamayun_kit5k-v1_fra-lin_LIN.txt"

if not (swc_file.exists() and fra_file_a.exists()):
    raise FileNotFoundError(f"Missing Track A source files in {swc_fra_dir}")
if not (fra_file_b.exists() and lin_file.exists()):
    raise FileNotFoundError(f"Missing Track B source files in {fra_lin_dir}")

track_a_pairs = _read_parallel(swc_file, fra_file_a, "swa", "fra")
track_b_pairs = _read_parallel(fra_file_b, lin_file, "fra", "lin")

print(f"Track A source pairs loaded: {len(track_a_pairs)}")
print(f"Track B source pairs loaded: {len(track_b_pairs)}")

lingala_sprinkle_vocab = ["soki", "batu", "bazali", "ndenge", "mpe", "ya", "ba"]
swahili_sprinkle_vocab = ["na", "kwa", "hivyo", "lakini", "sasa", "basi", "pia"]

def _detect_switch_points(tags):
    pts = []
    prev = None
    for i, t in enumerate(tags):
        if t == "punct":
            continue
        if prev is None:
            prev = t
            continue
        if t != prev:
            pts.append(i)
        prev = t
    return pts

def _acceptability(tokens, tags):
    if not tokens:
        return 0.0
    non_punct = [t for t in tags if t != "punct"]
    if not non_punct:
        return 0.0
    switch_count = len(_detect_switch_points(tags))
    frac_non_primary = (sum(t != "fra" for t in non_punct) / len(non_punct))
    length_bonus = min(1.0, len(tokens) / 12.0)
    return float(np.clip(0.45 + 0.25 * length_bonus + 0.2 * (1.0 - abs(frac_non_primary - 0.45)) + 0.1 * min(1.0, switch_count / 4), 0.0, 1.0))

def _compose_record(pair, secondary_lang: str, sprinkle_lang: str, sprinkle_vocab, rec_id: str, track_name: str):
    fra_toks = _tok(_norm(pair["fra"]))
    sec_toks = _tok(_norm(pair[secondary_lang]))

    out_toks = fra_toks[:]
    out_tags = ["fra" if _is_word(t) else "punct" for t in out_toks]

    fra_pos = [i for i, t in enumerate(out_toks) if _is_word(t)]
    sec_pos = [i for i, t in enumerate(sec_toks) if _is_word(t)]

    if not fra_pos or not sec_pos:
        return None

    sec_ratio = float(rng.uniform(0.35, 0.45))
    spr_ratio = float(rng.uniform(0.05, 0.12))

    n_words = len(fra_pos)
    n_secondary = max(1, min(n_words, int(round(n_words * sec_ratio))))
    chosen_secondary = sorted(rng.choice(fra_pos, size=n_secondary, replace=False).tolist())

    for rank, out_idx in enumerate(chosen_secondary):
        mapped = sec_pos[min(int((rank / max(1, len(chosen_secondary) - 1)) * (len(sec_pos) - 1)), len(sec_pos) - 1)]
        out_toks[out_idx] = sec_toks[mapped]
        out_tags[out_idx] = secondary_lang

    remaining = [i for i in fra_pos if out_tags[i] == "fra"]
    if remaining:
        n_spr = max(1, min(len(remaining), int(round(n_words * spr_ratio))))
        chosen_spr = rng.choice(remaining, size=n_spr, replace=False).tolist()
        for out_idx in chosen_spr:
            out_toks[out_idx] = str(rng.choice(sprinkle_vocab))
            out_tags[out_idx] = sprinkle_lang

    text = " ".join(out_toks)
    text = re.sub(r"\s+([,.;:!?])", r"\1", text)

    quality = {
        "grammar_score": round(float(np.clip(0.80 + 0.15 * rng.random(), 0.0, 1.0)), 3),
        "toxicity_flag": False,
        "cs_acceptability": round(_acceptability(out_toks, out_tags), 3),
    }

    return {
        "id": rec_id,
        "track": track_name,
        "text": text,
        "tokens": out_toks,
        "lang_tags": out_tags,
        "matrix_lang": "fra",
        "switch_points": _detect_switch_points(out_tags),
        "source_trace": {
            "method": "dual_track_rule_bootstrap",
            "track": track_name,
            "secondary_lang": secondary_lang,
            "sprinkle_lang": sprinkle_lang,
        },
        "quality": quality,
    }

def generate_track_dataset(pairs, track_name: str, secondary_lang: str, sprinkle_lang: str, sprinkle_vocab, target_n: int = 4000, min_acceptability: float = 0.72):
    rows = []
    i = 0
    while len(rows) < target_n:
        pair = pairs[i % len(pairs)]
        rec_id = f"{track_name.lower()}_txt_{len(rows)+1:06d}"
        rec = _compose_record(
            pair=pair,
            secondary_lang=secondary_lang,
            sprinkle_lang=sprinkle_lang,
            sprinkle_vocab=sprinkle_vocab,
            rec_id=rec_id,
            track_name=track_name,
        )
        if rec is not None and rec["quality"]["cs_acceptability"] >= min_acceptability:
            rows.append(rec)
        i += 1
    return rows

# Generate two tracks separately
track_a_text = generate_track_dataset(
    pairs=track_a_pairs,
    track_name="TRACK_A_FRA_SWA_LINSPR",
    secondary_lang="swa",
    sprinkle_lang="lin",
    sprinkle_vocab=lingala_sprinkle_vocab,
    target_n=4000,
    min_acceptability=0.72,
)

track_b_text = generate_track_dataset(
    pairs=track_b_pairs,
    track_name="TRACK_B_FRA_LIN_SWASPR",
    secondary_lang="lin",
    sprinkle_lang="swa",
    sprinkle_vocab=swahili_sprinkle_vocab,
    target_n=4000,
    min_acceptability=0.72,
)

# Save separate outputs
track_a_jsonl = DUAL_TEXT_OUT / "cs_text_track_a_fra_swa_linspr.jsonl"
track_b_jsonl = DUAL_TEXT_OUT / "cs_text_track_b_fra_lin_swaspr.jsonl"
combined_jsonl = DUAL_TEXT_OUT / "cs_text_track_ab_shuffled.jsonl"

for path, rows in [(track_a_jsonl, track_a_text), (track_b_jsonl, track_b_text)]:
    with path.open("w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")

combined_shuffled = track_a_text + track_b_text
rng.shuffle(combined_shuffled)
with combined_jsonl.open("w", encoding="utf-8") as f:
    for r in combined_shuffled:
        f.write(json.dumps(r, ensure_ascii=False) + "\n")

def baseline_metrics(rows, name: str):
    if not rows:
        return {"name": name, "records": 0}

    accept = [r["quality"]["cs_acceptability"] for r in rows]
    switch_counts = [len(r.get("switch_points", [])) for r in rows]
    tag_counts = Counter()
    for r in rows:
        tag_counts.update(t for t in r.get("lang_tags", []) if t in {"fra", "swa", "lin"})
    total_tags = sum(tag_counts.values()) or 1

    return {
        "name": name,
        "records": len(rows),
        "avg_cs_acceptability": round(float(np.mean(accept)), 3),
        "avg_switch_points": round(float(np.mean(switch_counts)), 3),
        "lang_pct": {
            "fra": round(100.0 * tag_counts.get("fra", 0) / total_tags, 2),
            "swa": round(100.0 * tag_counts.get("swa", 0) / total_tags, 2),
            "lin": round(100.0 * tag_counts.get("lin", 0) / total_tags, 2),
        },
    }

baseline_report = {
    "date": DATE_TAG,
    "track_a": baseline_metrics(track_a_text, "A_fra_swa_linspr"),
    "track_b": baseline_metrics(track_b_text, "B_fra_lin_swaspr"),
    "combined_shuffled": baseline_metrics(combined_shuffled, "AB_shuffled"),
    "artifacts": {
        "track_a_jsonl": str(track_a_jsonl),
        "track_b_jsonl": str(track_b_jsonl),
        "combined_jsonl": str(combined_jsonl),
    },
}

baseline_path = DUAL_MANIFEST_OUT / "baseline_metrics_dual_track.json"
with baseline_path.open("w", encoding="utf-8") as f:
    json.dump(baseline_report, f, ensure_ascii=False, indent=2)

print("Dual-track generation complete.")
