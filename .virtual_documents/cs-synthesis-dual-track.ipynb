def split_ids(ids: Sequence[str], train: float = 0.8, dev: float = 0.1) -> Dict[str, List[str]]:
    ids = list(ids)
    rng.shuffle(ids)
    n = len(ids)
    n_train = int(n * train)
    n_dev = int(n * dev)
    return {
        "train": ids[:n_train],
        "dev": ids[n_train:n_train + n_dev],
        "test": ids[n_train + n_dev:],
    }


