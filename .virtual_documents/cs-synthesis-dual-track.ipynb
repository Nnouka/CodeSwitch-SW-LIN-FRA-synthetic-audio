print(f"Track B records: {len(track_b_text)} -> {track_b_jsonl}")
print(f"Combined shuffled records: {len(combined_shuffled)} -> {combined_jsonl}")
print(f"Baseline report saved: {baseline_path}")

print("\nBaseline snapshot:")
print(json.dumps({
    "track_a": baseline_report["track_a"],
    "track_b": baseline_report["track_b"],
    "combined_shuffled": baseline_report["combined_shuffled"],
}, indent=2))



